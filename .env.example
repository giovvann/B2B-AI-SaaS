# Veliora — ejemplo de variables (NO pongas valores reales aquí).
# Copia a .env.local para dev. En Vercel: Settings → Environment Variables
# (Production + Preview) y redeploy SIN caché tras cambiarlas.
# Las NEXT_PUBLIC_* se incrustan en el build: cambiarlas exige rebuild.

# ---- App ----
NEXT_PUBLIC_SITE_URL=https://veliora.lat
NEXT_PUBLIC_SUBSCRIPTION_PRICE=199

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ... (SOLO servidor, jamás NEXT_PUBLIC_)

# ---- IA (patrón NVIDIA primario → Gemini fallback) ----
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
GOOGLE_GEMINI_API_KEY=
# Asistente (opcional, default interno si falta):
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ---- Push / Cron ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
CRON_SECRET= (el cron de Vercel lo manda como Bearer; sin esto, trials eternos)

# ---- WhatsApp worker ----
VELIORA_WA_SECRET=
WHATSAPP_WORKER_URL=
SUPERADMIN_EMAIL=
SUPERADMIN_WHATSAPP=

# ---- Pagos automáticos sin adultos (nuevos) ----
PAY_CLABE_LAST4= (4 últimos dígitos de tu CLABE Cuenta Básica 15+)
PAY_WALLET_SOLANA= (tu dirección Phantom/Solflare)
HELIUS_AUTH= (password largo para el webhook de Helius)
PAY_USDC_CENTS=1050
NEXT_PUBLIC_PAY_CLABE=
NEXT_PUBLIC_PAY_TITULAR=Veliora
NEXT_PUBLIC_PAY_WALLET=
